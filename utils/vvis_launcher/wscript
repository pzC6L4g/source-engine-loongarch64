from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'vvis_linux'

def options(opt):
	# stub
	return

def configure(conf):
	conf.define('LAUNCHERONLY',1)
	conf.define('CFLAGS', conf.env.CFLAGS)
	conf.define('LDFLAGS', conf.env.LINKFLAGS)

def build(bld):
	source = [
		'vvis_launcher.cpp',
		'StdAfx.cpp'
	]

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common'
	]

	defines = []

	libs = ['tier0','tier1','vstdlib']

	install_path = bld.env.LIBDIR

	link_flags = [
		'-Wl,-rpath,' + bld.env.LIBDIR,
		'-Wl,--enable-new-dtags',
		'-Wl,-rpath,$$ORIGIN',
	]

	bld(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx cxxprogram',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		linkflags = link_flags,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)

