from waflib import Utils
import os

top = '.'
PROJECT_NAME = 'video_webm'

def options(opt):
	# stub
	return

def configure(conf):
	return

def build(bld):
	source = [
		'webm_video.cpp',
		'webm_recorder.cpp',
		'../../public/tier0/memoverride.cpp'
	]

	includes = [
		'.',
		'../../public',
		'../../public/tier0',
		'../../public/tier1',
		'../../common',
		'../',
		'../../thirdparty/libvpx-v1.1.0',
		'../../thirdparty/libvorbis-1.3.2/include',
		'../../thirdparty/libwebm',
		'../../thirdparty/libogg-1.2.2/include'
	]

	defines = []

	libs = ['tier1','tier2', 'libvorbis', 'libvpx', 'libwebm', 'libvorbisenc', 'libogg']

	if bld.env.DEST_OS == 'win32':
		includes += ['../../dx9sdk/include']
		libs += ['VFW32']
	elif bld.env.DEST_OS == 'darwin':
		libs += ['CARBON', 'iconv']

	install_path = bld.env.LIBDIR

	bld.shlib(
		source   = source,
		target   = PROJECT_NAME,
		name     = PROJECT_NAME,
		features = 'c cxx',
		includes = includes,
		defines  = defines,
		use      = libs,
		install_path = install_path,
		subsystem = bld.env.MSVC_SUBSYSTEM,
		idx      = bld.get_taskgen_count()
	)
